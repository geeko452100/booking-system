{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "booking-system",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	"observability": {
		"enabled": true
	},
	// The React build is served as static assets; only /api/* runs the Worker.
	"assets": {
		"directory": "../client/dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "booking",
			"database_id": "19270f8b-5ff1-4d74-911c-6e8f912db953",
			"migrations_dir": "migrations",
			"remote": true
		}
	],
	// Per-IP limit on sign-in and sign-up attempts.
	"ratelimits": [
		{
			"name": "AUTH_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 20,
				"period": 60
			}
		}
	],
	"vars": {
		"DEMO_MODE": "1",
		// Must match the cron schedule below.
		"DEMO_RESET_MINUTES": "60",
		// Demo appointments are placed 9am–5pm in this timezone.
		"DEMO_TIMEZONE": "America/New_York"
	},
	// Demo data reset. Only runs while DEMO_MODE is "1".
	"triggers": {
		"crons": [
			"0 * * * *"
		]
	}
	// Secret, set with `npx wrangler secret put JWT_SECRET` (and in .dev.vars for local dev).
}